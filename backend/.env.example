# Copier ce fichier en .env et renseigner vos vraies valeurs.
# Ne JAMAIS committer le fichier .env (voir .gitignore).

# --- Flask ---------------------------------------------------------------
SECRET_KEY=change-me-please
FLASK_DEBUG=true
MAX_CONTENT_LENGTH_MB=10

# --- MongoDB Atlas ---------------------------------------------------------
# Récupérable dans Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DBNAME=ats_ia
VECTOR_INDEX_NAME=vector_index
EMBEDDINGS_COLLECTION=embeddings

# --- GridFS (stockage des CV PDF) ----------------------------------------
GRIDFS_BUCKET_NAME=cv_files

# --- JWT -------------------------------------------------------------------
JWT_SECRET_KEY=change-me-please-too
JWT_EXPIRES_HOURS=8

# --- LLM Provider (chatbot + embeddings) -----------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# --- CORS (origine du frontend Streamlit) ----------------------------------
CORS_ORIGINS=http://localhost:8501
